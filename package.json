{
  "name": "wagen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/types.ts",
    "db:test:rls": "bash -c \"docker exec -i supabase_db_wagen psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/tests/rls.test.sql\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "supabase": "^2.115.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
