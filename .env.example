# =============================================================================
# wagen - primjer okoline. Kopiraj u .env.local i popuni stvarnim vrijednostima.
# .env.local je u .gitignore i NIKAD se ne commita.
#
# Supabase je presao na novi format kljuceva: sb_publishable_... (javni) i
# sb_secret_... (tajni). Stari anon/service_role jos rade, ali koristimo nove.
# =============================================================================

# --- Supabase: lokalni stack -------------------------------------------------
# `pnpm db:status` ispise stvarne vrijednosti. Za lokalni stack to su fiksni
# razvojni defaulti - nisu tajna.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# App cilja CLOUD wagen-dev: fizicki uredjaj ne vidi 127.0.0.1 (web ostaje lokalan)
EXPO_PUBLIC_SUPABASE_URL="https://<dev-ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Sluzi samo serveru i Node workeru - NIKAD ne smije zavrsiti u web ili app
# bundleu. Zaobilazi RLS u potpunosti.
SUPABASE_SECRET_KEY=""

# Izravna veza na bazu (migracije, seed, testovi RLS politika).
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase: udaljeni projekti ---------------------------------------------
# Reference iz URL-a dashboarda: https://supabase.com/dashboard/project/<REF>
SUPABASE_PROJECT_REF_DEV=""
SUPABASE_PROJECT_REF_PROD=""

# Lozinka baze, trazi ju `supabase link` i `supabase db push`.
SUPABASE_DB_PASSWORD_DEV=""
SUPABASE_DB_PASSWORD_PROD=""

# --- Vanjski servisi (dolaze u koracima E2 i E3) ------------------------------
# Outvin - VIN dekodiranje (3.2)
OUTVIN_API_KEY=""

# Anthropic - prijevod equipment_codes (13.4), NL pretraga (16.1), moderacija (8)
ANTHROPIC_API_KEY=""

# --- Jos nije odluceno -------------------------------------------------------
# SMS provider: Twilio (ODLUCENO, 5.2). Lokalno se koristi auth.sms.test_otp
# iz config.toml - stvarne vrijednosti trebaju tek za cloud projekte.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_MESSAGING_SERVICE_SID=""

# Google OAuth (5.1) - konfigurira se na cloud projektu u B11
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# CLI access token: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""
