# Metro (React Native bundler) povijesno lose prati simbolicke linkove, pa
# node_modules mora izgledati "plosnato". Zadrzavamo pnpm store i workspace
# protokol, gubimo samo strogu izolaciju stabla. Expova preporuka za monorepe.
node-linker=hoisted

# React Native ekosustav ima kronicno neuredne peer deps; strogi nacin bi
# blokirao instalaciju na tudim gresama.
strict-peer-dependencies=false

# Determinizam: CI i lokalno moraju dobiti isto stablo.
resolution-mode=highest
